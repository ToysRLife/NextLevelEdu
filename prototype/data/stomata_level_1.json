{
  "levelId": "BIO-STOMATA-L1",
  "title": "Level 1: The Perfect Spring Day",
  "environment": {
    "temperature": 22.0,
    "humidity": 0.60,
    "sunlight": 0.80,
    "ambientCO2": 100.0
  },
  "initialState": {
    "waterLevel": 100.0,
    "storedCO2": 0.0,
    "glucose": 0.0,
    "stomataAperture": 0.5 
  },
  "winCondition": {
    "targetGlucose": 100.0,
    "minWaterLevel": 1.0
  },
  "tickRules": {
    "waterLoss": "state.stomataAperture * env.temperature * (1.0 - env.humidity) * 0.005",
    "co2Intake": "state.stomataAperture * env.ambientCO2 * 0.01",
    "glucoseGain": "state.storedCO2 > 0 ? env.sunlight * 0.02 : 0",
    "co2Consumption": "state.storedCO2 > 0 ? env.sunlight * 0.01 : 0"
  }
}