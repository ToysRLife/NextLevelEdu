{
  "name": "nextlevel-edu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NextLevel Edu — K-12 science learning through games",
  "scripts": {
    "dev": "vite",
    "gen:manifests": "node scripts/gen-manifests.mjs",
    "check:solvable": "node scripts/check-solvable.mjs",
    "prebuild": "node scripts/gen-manifests.mjs && node scripts/check-solvable.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.11"
  },
  "dependencies": {
    "firebase": "^12.14.0"
  }
}
